{FPC port: Hercules hardware access (I/O ports, 6845 programming) cannot be
 done from a portable program, so every Hercules routine is stubbed to report
 "no Hercules card". The video page routines are emulated with off-screen
 buffers: the visible page lives in VideoBuffer, the other pages in
 PageStore.}

  function HercPresent : Boolean;
    {-Return true if a Hercules graphics card is present}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
    HercPresent := False;
  end;

  function WhichHercCard : HercCardType;
    {-Returns Hercules card type}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
    WhichHercCard := HercNone;
  end;

  procedure SwitchInColorCard(ColorOn : Boolean);
    {-Activate or deactivate colors on a Hercules InColor card}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
  end;

  function HercGraphicsMode : Boolean;
    {-Return True if a Hercules card is in graphics mode}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
    HercGraphicsMode := False;
  end;

  function HercModeTestWorks : Boolean;
    {-Return True if HercGraphicsMode will work}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
    HercModeTestWorks := False;
  end;

  procedure SetHercMode(GraphMode : Boolean; GraphPage : Byte);
    {-Set Hercules card to graphics mode or text mode, and activate specified
      graphics page (if switching to graphics mode).}
  begin
    {FPC port: stubbed because there is no Hercules hardware access}
  end;

  function PageBytes : LongInt;
    {-Size in bytes of one emulated video page}
  begin
    PageBytes := LongInt(PhysW) * PhysH * 2;
  end;

  procedure BlankCells(P : Pointer; Count : LongInt; W : Word);
  var
    I : LongInt;
  begin
    for I := 0 to Count-1 do
      PCells(P)^[I] := W;
  end;

  function StoreFor(PageNo : Byte) : Pointer;
    {-Off-screen buffer for a page (allocated on demand, blank)}
  begin
    if PageStore[PageNo] = nil then begin
      GetMem(PageStore[PageNo], PageBytes);
      BlankCells(PageStore[PageNo], PageBytes shr 1, $0720);
    end;
    StoreFor := PageStore[PageNo];
  end;

  function GetPageSegment(PageNo : Byte) : Word;
    {-Get the video segment corresponding to the specified video page}
  begin
    {FPC port: there are no segments; this only returns a legacy token}
    GetPageSegment := VideoSegment;
    if (PageNo < MaxPages) and (CurrentMode <= 3) then
      GetPageSegment := $B800 + PageNo*$100;
  end;

  function GetPagePointer(PageNo : Byte) : Pointer;
    {-Get a pointer to the start of the specified video page}
  begin
    if (PageNo = VisiblePage) or (PageNo >= MaxPages) then
      GetPagePointer := VideoBuffer
    else
      GetPagePointer := StoreFor(PageNo);
  end;

  procedure SetActivePage(PageNo : Byte);
   {-Selects the video page that will be written to with subsequent operations
     on the screen. Does not affect Write/Ln or Read/Ln.}
  begin
    if PageNo >= MaxPages then
      Exit;
    ActivePageNo := PageNo;
    VirtualBuffer := GetPagePointer(PageNo);
    VirtualSegment := GetPageSegment(PageNo);
  end;

  procedure ClearPage(PageNo : Byte);
    {-Clear the specified video page with TextChar and TextAttr}
  var
    P : Pointer;
  begin
    P := GetPagePointer(PageNo);
    BlankCells(P, LongInt(PhysW) * PhysH, (Word(TextAttr) shl 8) or Ord(TextChar));
    TextChar := ' ';
    if P = VideoBuffer then
      ScreenChanged;
  end;

  procedure SetVisiblePage(PageNum : Byte);
    {-Set current video page}
  var
    Tracking : Boolean;
    Old : Byte;
  begin
    if (PageNum >= MaxPages) or (PageNum = VisiblePage) then
      Exit;
    {does the active page follow the page being swapped?}
    Tracking := (VirtualBuffer = GetPagePointer(ActivePageNo));
    Old := VisiblePage;
    Move(VideoBuffer^, StoreFor(Old)^, PageBytes);
    Move(StoreFor(PageNum)^, VideoBuffer^, PageBytes);
    VisiblePage := PageNum;
    CurrentPage := PageNum;
    if Tracking then
      VirtualBuffer := GetPagePointer(ActivePageNo);
    ScreenChanged;
  end;
